SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
GEMINI_API_KEY=your-gemini-api-key

# SMTP transaccional. EMAIL_HOST/PORT/USE_TLS/DEFAULT_FROM_EMAIL tienen
# default razonable en settings.py si se omiten; EMAIL_HOST_USER y
# EMAIL_HOST_PASSWORD no tienen default — sin ellos el envío de correo
# falla en vez de usar una credencial inventada. Nunca poner acá
# credenciales reales: este archivo es de ejemplo y se versiona en git.
EMAIL_HOST=mail.polarzero.dev
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=TributIA <tributia@polarzero.dev>

# Fase 2: verificación de correo al registrarse. Apagado por defecto —
# el registro siempre manda el correo, pero el login solo se bloquea
# para cuentas sin verificar si esto es 'true'.
EMAIL_VERIFICATION_REQUIRED=false
EMAIL_VERIFICATION_TOKEN_HORAS=48

# Solo se usan dentro de docker-compose (servicio "db"); en desarrollo
# local sin Docker no hacen falta, se usa SQLite automáticamente.
POSTGRES_DB=tributia
POSTGRES_USER=tributia
POSTGRES_PASSWORD=change-me
